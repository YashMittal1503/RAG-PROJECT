# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Database (Supabase Postgres — use the "connection string" from Settings > Database) ──
DATABASE_URL=postgresql+asyncpg://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Qdrant Cloud ──────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Groq LLM (Tier 1 Primary — sub-second LPUs) ──────────────────────────
# Provide up to 3+ keys for automatic round-robin load distribution and rate-limit rotation
GROQ_API_KEY=gsk_your_groq_api_key_1
GROQ_API_KEY_2=gsk_your_groq_api_key_2
GROQ_API_KEY_3=gsk_your_groq_api_key_3
# Or comma-separated list: GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MODEL=openai/gpt-oss-120b

# ── Frontend URL (for CORS) ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Observability (Logfire) ──────────────────────────────────────────────
# Optional: Get a free token at https://logfire.pydantic.dev to view web traces.
# If omitted, Logfire automatically logs beautiful structured traces to your console.
LOGFIRE_TOKEN=

# ── Multi-Provider Multi-Key Fallbacks (Optional but Recommended) ─────────
# Tier 2: Google Gemini (generous free quotas: https://aistudio.google.com)
# Provide up to 3+ keys for round-robin and 429 rotation
GEMINI_API_KEY=AIza_your_gemini_key_1
GEMINI_API_KEY_2=AIza_your_gemini_key_2
GEMINI_API_KEY_3=AIza_your_gemini_key_3
# Or comma-separated list: GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-1.5-flash

# Tier 3: OpenRouter (universal fail-safe: https://openrouter.ai)
# Provide up to 3+ keys for round-robin and 429 rotation
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_1
OPENROUTER_API_KEY_2=sk-or-v1-your_openrouter_key_2
OPENROUTER_API_KEY_3=sk-or-v1-your_openrouter_key_3
# Or comma-separated list: OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

