# Settings for the DocTalk deploy agent and backups. bootstrap.sh copies this to /etc/doctalk/deploy.env
# (filling in ENV_FILE and DATA_DIR) the first time; edit that copy on the server, not this file.

# Image to run, and the tag CI moves after the tests pass
IMAGE=ghcr.io/yashmittal1503/doctalk-backend
TRACK_TAG=production
CONTAINER=doctalk-backend

# The backend's secrets (.env) and its persistent data (DuckDB spreadsheets), on the host
ENV_FILE=/home/ubuntu/RAG-PROJECT/backend/.env
DATA_DIR=/home/ubuntu/RAG-PROJECT/backend/data

# Host ports, bound to 127.0.0.1 only (nginx proxies to one of them). Health checks use the first.
HOST_PORTS="8000 10000"
CONTAINER_PORT=10000
HEALTH_TIMEOUT=240

# Backups of DATA_DIR (backup.sh, daily). Optional S3 copy: needs the AWS CLI and an instance role
# that can write to the bucket, e.g. BACKUP_S3_URI=s3://my-bucket/doctalk
BACKUP_DIR=/var/backups/doctalk
BACKUP_KEEP_DAYS=14
BACKUP_S3_URI=
